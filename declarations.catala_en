  data involvesPoliticalParty content YesNo
  data involvesCEC content YesNo
  data involvesNotaryEnforcement content YesNo
  data involvesCourtOrJudge content YesNo
  data hasRelatedClaim content YesNo
  data relatedClaimInSameCase content YesNo
  data relatedClaimFiledAfterDecision content YesNo
  data noProceedingsWithin10Days content YesNo
  data caseBelongsElsewhere content YesNo
  data needFairTrial content YesNo
  data defendantRelocated content YesNo

declaration structure VenueDetermination:
  data check content JurisdictionCheck
  data plaintiffLocationRegion content YesNo
  data plaintiffResidenceKnown content YesNo
  data actIssuedInKyiv content YesNo
  data actionOccurredInKyiv content YesNo
  data defendantRegisteredInKyiv content YesNo
