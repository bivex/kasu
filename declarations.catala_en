declaration structure SubjectOfAuthority:
  data kind content SubjectOfAuthorityKind
  data actsInPublicCapacity content YesNo
  data providesAdministrativeServices content YesNo

declaration structure AdministrativeCase:
  data plaintiff content ApplicantType
  data defendant content SubjectOfAuthority
  data disputeCategory content DisputeCategory
  data protectionMethod content ProtectionMethod
  data proceedingForm content ProceedingForm
  data filedDate content date
  data disputeAmountMinimums content integer
  data preTrialStatus content PreTrialStatus
  data hasPreTrialAttempt content YesNo
  data isPublicServiceDispute content YesNo
  data isElectionDispute content YesNo

declaration structure CourtReviewResult:
  data criterion content ReviewCriterion
  data satisfied content YesNo

declaration structure SimplifiedProceedingCheck:
  data case content AdministrativeCase
  data isMinorComplexity content YesNo
  data disputeBelowFinancialThreshold content YesNo
  data isTypicalCase content YesNo
  data isNormativeReproduction content YesNo
  data isCorruptionOfficial content YesNo
  data claimsCompensationAboveThreshold content YesNo
  data isForcedExpropriation content YesNo

declaration structure JurisdictionCheck:
  data case content AdministrativeCase
  data disputeSubjectCategory content SubjectJurisdictionCategory
  data involvesCivilContract content YesNo
  data involvesLaborDispute content YesNo
  data involvesCriminalProceeding content YesNo
  data involvesCommercialDispute content YesNo
  data defendantIsNationalLevel content YesNo
  data defendantIsRegionalLevel content YesNo
  data defendantIsLocalLevel content YesNo
