## Article 289-6. NSSC asset arrest cases

```catala
declaration scope Article2896NSSCAssetArrest:
  input check content NSSCAssetArrestCheck
  output challengeAllowed content YesNo
  output filingWithinDeadline content YesNo
  output appealWithinDeadline content YesNo

scope Article2896NSSCAssetArrest:
# NSSC asset arrest decisions can be challenged
  label arrest_challenge definition challengeAllowed under condition
    check.requestType = NSSCRequestType.AssetArrestChallenge
    and check.assetArrestOrdered = Yes
    consequence equals Yes

  label extension_challenge definition challengeAllowed under condition
    check.requestType = NSSCRequestType.AssetArrestExtensionChallenge
    and check.arrestExtensionRequested = Yes
    consequence equals Yes

  label modification_challenge definition challengeAllowed under condition
    check.requestType = NSSCRequestType.AssetArrestModificationChallenge
    and check.arrestModificationRequested = Yes
    consequence equals Yes

  label no_challenge definition challengeAllowed equals No

# Filing within 5 days
  label timely definition filingWithinDeadline under condition
    check.filedWithinFiveDays = Yes
    consequence equals Yes

  label untimely definition filingWithinDeadline under condition
    check.filedWithinFiveDays = No
    consequence equals No

# Appeal within 3 days
  label timely_appeal definition appealWithinDeadline under condition
    check.appealFiledWithinThreeDays = Yes
    consequence equals Yes

  label untimely_appeal definition appealWithinDeadline under condition
    check.appealFiledWithinThreeDays = No
    consequence equals No
```

