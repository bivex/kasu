## Article 289-9. Religious organization termination cases

```catala
declaration scope Article2899ReligiousOrgTermination:
  input check content ReligiousOrgTerminationCheck
  output terminationAllowed content YesNo
  output supremeCourtHasJurisdiction content YesNo
  output generalProceedingRequired content YesNo

scope Article2899ReligiousOrgTermination:
# Religious organization termination can be challenged
  label termination definition terminationAllowed under condition
    check.ground = ReligiousOrgGround.ProhibitedActivity
    and check.filedByAuthorizedBody = Yes
    consequence equals Yes

  label foreign_influence definition terminationAllowed under condition
    check.ground = ReligiousOrgGround.ForeignInfluence
    and check.filedByAuthorizedBody = Yes
    consequence equals Yes

  label national_security definition terminationAllowed under condition
    check.ground = ReligiousOrgGround.NationalSecurityThreat
    and check.filedByAuthorizedBody = Yes
    consequence equals Yes

  label public_order definition terminationAllowed under condition
    check.ground = ReligiousOrgGround.PublicOrderViolation
    and check.filedByAuthorizedBody = Yes
    consequence equals Yes

  label no_termination definition terminationAllowed equals No

# Supreme Court has jurisdiction
  label supreme definition supremeCourtHasJurisdiction under condition
    check.supremeCourtJurisdiction = Yes
    consequence equals Yes

  label not_supreme definition supremeCourtHasJurisdiction equals No

# General proceeding required
  label general definition generalProceedingRequired equals Yes
```

